# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN RÈM ONLINE TRÊN RENDER (WEB SERVICE)
# ==============================================================================

# 1. THÔNG TIN ỨNG DỤNG (APPLICATION)
APP_NAME="Rèm Cửa Online"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE-NAME.onrender.com
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
TRUSTED_PROXIES=*

# 2. CƠ SỞ DỮ LIỆU AIVEN MYSQL CLOUD (CÓ SSL CA)
DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST.aivencloud.com
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD_HERE
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# 3. QUẢN LÝ PHIÊN, CACHE & LOG
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# 4. CẤU HÌNH CONTAINER & KHỞI TẠO DỮ LIỆU
PORT=10000
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# 5. KHỞI TẠO TÀI KHOẢN QUẢN TRỊ VIÊN (ADMIN SEEDING)
SEED_ADMIN_NAME="Quản Trị Viên"
SEED_ADMIN_EMAIL=admin@remonline.vn
SEED_ADMIN_PASSWORD=MatKhauBaoMat123456!

# 6. DỊCH VỤ EMAIL
MAIL_MAILER=log
MAIL_FROM_ADDRESS=support@remonline.vn
MAIL_FROM_NAME="Rèm Cửa Online"

# 7. CỔNG THANH TOÁN MOMO (SANDBOX / PRODUCTION)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://YOUR-SERVICE-NAME.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://YOUR-SERVICE-NAME.onrender.com/payment/momo/ipn
MOMO_VERIFY_SSL=true

# 8. TÍCH HỢP VẬN CHUYỂN GIAO HÀNG NHANH (GHN)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=YOUR_GHN_API_TOKEN
GHN_SHOP_ID=YOUR_GHN_SHOP_ID
GHN_VERIFY_SSL=true
